# Telegram API credentials (from https://my.telegram.org/apps)
API_ID=12345678
API_HASH=your_api_hash_here

# Session name (optional, default: telegram_importer)
SESSION_NAME=telegram_importer

# Channels to sync (comma-separated usernames without @)
CHANNELS=channel1,channel2

# Whisper model size: tiny/base/small/medium/large-v3 (default: base)
WHISPER_MODEL=base

# Whisper language (optional, default: auto-detect)
WHISPER_LANGUAGE=ru

# Database path (default: db.sqlite3)
DB_PATH=db.sqlite3

# Media storage path (default: data/media)
MEDIA_DIR=data/media

# Export path (default: data/exports)
EXPORT_DIR=data/exports

# Parsed Web UI JSON path (optional, default: data/parsed)
PARSED_DIR=data/parsed
